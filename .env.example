# =============================================================
# CRM Fatturazione - variabili d'ambiente (copiare in .env)
# Non committare mai il file .env con valori reali.
# =============================================================

# Applicazione
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Rome

# Database MySQL/MariaDB
DB_HOST=localhost
DB_NAME=crm_fatturazione
DB_USER=crm_user
DB_PASS=change-me
DB_CHARSET=utf8mb4

# Stripe (usare le chiavi di test in sviluppo)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# Testo per riconoscere l'account Stripe Connect del partner (nome o email)
STRIPE_PARTNER_MATCH=partner

# Fatture in Cloud (OAuth app)
FIC_APP_ID=
FIC_CLIENT_ID=
FIC_CLIENT_SECRET=
FIC_OAUTH_REDIRECT=http://localhost:8000/modules/fatture/actions/fic_oauth_callback.php
FIC_OAUTH_SCOPE=
FIC_BASE_URL=https://api-v2.fattureincloud.it
FIC_ACCESS_TOKEN=
FIC_COMPANY_ID=
FIC_VAT_TYPE_ID=0
FIC_PAYMENT_METHOD_ID=

# Facebook Lead Ads (opzionale)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/modules/lead/facebook_callback.php
FACEBOOK_API_VERSION=v21.0
FACEBOOK_PAGE_ID=
FACEBOOK_LEAD_FORM_ID=

# Email (SMTP/IMAP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=ssl
MAIL_FROM_EMAIL=fatturazione@example.com
MAIL_FROM_NAME=CRM Fatturazione
MAIL_REPLY_TO=fatturazione@example.com
IMAP_HOST=imap.example.com
IMAP_PORT=993
# Copia nascosta interna delle email fattura (opzionale)
MAIL_INTERNAL_COPY=

# Cron: chiave per gli endpoint in /cron (?key=...) - stringa casuale lunga
CRON_KEY=
# Chiave per la sincronizzazione Stripe schedulata (?cron=...)
CRON_SECRET=

# Utente "fatturazione" con accesso amministrativo (creato da admin-monitor/setup.php)
BILLING_USER_EMAIL=
BILLING_USER_PASSWORD=
